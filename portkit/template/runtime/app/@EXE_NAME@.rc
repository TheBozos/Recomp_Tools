// The window build's resources on Windows: its icon (@TITLE@'s variant of The Bozos' logo, docs/branding/make_logo.py
// @PREFIX@; no game art), the UTF-8 manifest and its version information.
#include <winver.h>

1 ICON "@EXE_NAME@.ico"
1 24 "@EXE_NAME@.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@TITLE@"
            VALUE "ProductName", "@TITLE@ (@PROJECT@, a native PC port)"
            VALUE "InternalName", "@EXE_NAME@"
            VALUE "OriginalFilename", "@EXE_NAME@.exe"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
